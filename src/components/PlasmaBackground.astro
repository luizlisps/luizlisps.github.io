<pre
    id="plasma-bg"
    aria-hidden="true"
    class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-lvh m-0 select-none [-webkit-text-size-adjust:100%] overflow-hidden whitespace-pre bg-[linear-gradient(120deg,var(--theme-accent),var(--theme-bg-subtle)_55%,var(--theme-visited))] bg-clip-text text-[12px] leading-[14px] text-transparent opacity-30 [font-family:var(--font-mono)] dark:opacity-20 sm:opacity-75 sm:[mask-composite:intersect] sm:[mask-image:linear-gradient(to_right,#000,rgb(0_0_0/0.45)_28%,rgb(0_0_0/0.45)_72%,#000),linear-gradient(to_bottom,rgb(0_0_0/0.8),#000_50%)] sm:[-webkit-mask-composite:source-in] sm:dark:opacity-55"
></pre>

<script>
    // Plasma by @bas3line (ascii.rest/plasma): four sine fields summed, read through a char ramp.
    const RAMP = ".,-~:;=+*#%@";
    const N = RAMP.length;
    const P = 30;
    const W = (2 * Math.PI) / P;
    const GAIN = 0.32;
    const REF_COLS = 64;
    const FPS = 24;

    const el = document.getElementById("plasma-bg") as HTMLPreElement;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");

    let cols = 0;
    let rows = 0;
    let X = new Float32Array(0);
    let Y = new Float32Array(0);
    let sized = { w: 0, h: 0 };

    function layout() {
        const probe = document.createElement("span");
        probe.textContent = "M".repeat(100);
        el.appendChild(probe);
        const cw = probe.getBoundingClientRect().width / 100 || 7.2;
        probe.remove();
        const { width, height } = el.getBoundingClientRect();
        sized = { w: width, h: height };
        cols = Math.ceil(width / cw) + 1;
        rows = Math.ceil(height / 14) + 1;
        // Same scale on both axes (rows are 2x a column's width), sized so the longer side spans the reference
        // piece: blobs stay round on a phone in portrait as well as on a desktop.
        const k = REF_COLS / Math.max(cols, rows * 2);
        X = Float32Array.from({ length: cols }, (_, c) => (c + 0.5 - cols / 2) * k);
        Y = Float32Array.from({ length: rows }, (_, r) => (r + 0.5 - rows / 2) * 2 * k);
    }

    function frame(t: number) {
        const a = W * t;
        const ca = Math.cos(a);
        const sa = Math.sin(a);
        const cx = 14 * Math.sin(a);
        const cy = 9 * Math.cos(2 * a);
        const out = new Array<string>(cols);
        const lines: string[] = [];
        for (let r = 0; r < rows; r++) {
            const y = Y[r]!;
            for (let c = 0; c < cols; c++) {
                const x = X[c]!;
                let v = Math.sin(x * 0.11 + 3 * a);
                v += Math.sin(y * 0.13 - 2 * a);
                v += Math.sin((x * ca + y * sa) * 0.09 + 4 * a);
                v += Math.sin(Math.hypot(x - cx, y - cy) * 0.17 - 5 * a);
                const u = v * GAIN + a / Math.PI;
                const k = Math.abs(u - 2 * Math.floor(u / 2 + 0.5));
                out[c] = RAMP[Math.min(N - 1, Math.floor(k * N))]!;
            }
            lines.push(out.join(""));
        }
        el.textContent = lines.join("\n");
    }

    let raf = 0;
    let last = 0;
    function tick(now: number) {
        raf = requestAnimationFrame(tick);
        if (now - last < 1000 / FPS) return;
        last = now;
        frame(now / 1000);
    }

    function start() {
        cancelAnimationFrame(raf);
        layout();
        if (reduced.matches || document.hidden) frame(0);
        if (!reduced.matches && !document.hidden) raf = requestAnimationFrame(tick);
    }

    // Mobile browsers fire resize while the URL bar collapses; ignore height jitter so the pattern doesn't jump.
    let resizeTimer = 0;
    addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
            const { width, height } = el.getBoundingClientRect();
            if (width !== sized.w || Math.abs(height - sized.h) > 120) start();
        }, 150);
    });
    document.addEventListener("visibilitychange", start);
    reduced.addEventListener("change", start);
    start();
</script>
