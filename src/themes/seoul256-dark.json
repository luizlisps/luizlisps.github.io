{
  "name": "seoul256-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#565656",
    "editor.foreground": "#D9D9D9"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#719872"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E17899"
      }
    },
    {
      "scope": [
        "keyword.control.conditional"
      ],
      "settings": {
        "foreground": "#98BEDE"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#E19972"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DEDD99"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#98BCBD"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string.template punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#BE9873"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFDE99"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#999ABD"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#6FBCBD"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FFBD98"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#DFDEBD"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#DFBC72"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "meta.structure",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#97DDDF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFBFBD"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#98BEDE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#BE9873"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#E0BEBC"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E12672"
      }
    }
  ]
}