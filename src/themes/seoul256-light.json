{
  "name": "seoul256-light",
  "type": "light",
  "colors": {
    "editor.background": "#D1D0D1",
    "editor.foreground": "#616161"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#719872"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E17899"
      }
    },
    {
      "scope": [
        "keyword.control.conditional"
      ],
      "settings": {
        "foreground": "#0099BD"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#BE7572"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#BE7572"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#009799"
      }
    },
    {
      "scope": [
        "punctuation.definition.string",
        "string.template punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#9A7200"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9A7372"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#E17899"
      }
    },
    {
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#007173"
      }
    },
    {
      "scope": [
        "constant.character",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#E19972"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#727100"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "storage.type.class"
      ],
      "settings": {
        "foreground": "#9A7200"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "meta.structure",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#007173"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9A7599"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#0099BD"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9A7200"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#9B1300"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E12672"
      }
    }
  ]
}